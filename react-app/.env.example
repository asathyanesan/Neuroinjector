# Base URL of the Cloudflare Worker that proxies chat completions to FlyerGPT.
# Reusing the existing worker from ds-research-tool-test: its ALLOWED_ORIGINS already
# includes https://asathyanesan.github.io (CORS only checks scheme+host, not path), so
# this assistant works from that same worker with no changes on the worker side.
VITE_WORKER_URL=https://neuroinjector-assistant-worker.myvivarium-online.workers.dev
